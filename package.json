{
  "name": "maya-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "list-groups": "tsx scripts/list-groups.ts",
    "backup-db": "tsx scripts/backup-db.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "baileys": "7.0.0-rc14",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.7",
    "node-cron": "4.6.0",
    "pino": "9.14.0",
    "qrcode-terminal": "0.12.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/qrcode-terminal": "0.12.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
