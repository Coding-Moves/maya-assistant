{
  "name": "maya-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "list-groups": "tsx scripts/list-groups.ts",
    "backup-db": "tsx scripts/backup-db.ts",
    "calendar-auth": "tsx scripts/google-calendar-auth.ts",
    "import-vu": "tsx scripts/import-vu.ts",
    "sync-vu": "tsx scripts/sync-vu.ts",
    "eval:phase3": "node --import tsx tests/context-phase3.test.mjs && node --import tsx --test tests/natural-done.test.mjs tests/task-expiry.test.mjs tests/extract-expired.test.mjs tests/owner-agent.test.mjs tests/owner-media.test.mjs tests/group-media-separate.test.mjs tests/whatsapp-router-separate.test.mjs",
    "eval:phase3:resources": "tsx scripts/eval-phase3-resources.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "baileys": "7.0.0-rc14",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.7",
    "node-cron": "4.6.0",
    "pino": "9.14.0",
    "playwright": "1.64.1",
    "qrcode-terminal": "0.12.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/qrcode-terminal": "0.12.2",
    "eslint": "10.12.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
