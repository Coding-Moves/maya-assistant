# ---------- Bot ----------
# Her name. In self mode, start with it or mention @maya anywhere.
BOT_NAME=Maya

# Your preferred name for occasional personal reminders (optional)
OWNER_NAME=

# self     = runs on your own WhatsApp number, you talk in "Message Yourself"
# separate = runs on a second number; all direct owner messages are handled
BOT_MODE=self

# Only for BOT_MODE=separate: YOUR main number, e.g. 923001234567@s.whatsapp.net
OWNER_JID=

# Comma-separated group IDs to read. Get them with: npm run list-groups
GROUP_ALLOWLIST=

# Your timezone (IANA name), used for reminders and dates
TIMEZONE=Asia/Karachi

# ---------- Schedule (cron format, in TIMEZONE) ----------
MORNING_DIGEST_CRON=0 8 * * *
EVENING_DIGEST_CRON=0 20 * * *
WEEKLY_PLAN_CRON=0 20 * * 5
EXTRACT_INTERVAL_MIN=10

# ---------- Optional VU Classic To Do daily check ----------
# Only assignments and quizzes. Keep credentials in the private VM .env, never Git.
# Install Playwright Chromium on the VM before enabling this.
VU_LMS_SYNC=false
VU_SYNC_CRON=0 6 * * *
VU_STUDENT_ID=
VU_PASSWORD=

# ---------- AI ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
EXTRACT_BATCH_SIZE=50
ASK_CONTEXT_MESSAGES=100
MEDIA_ENABLED=false
# Limits both opted-in group media and owner Status photo/video comments.
MEDIA_MAX_BYTES=5000000
MEDIA_BATCH_SIZE=3

# ---------- Optional Google Calendar ----------
# Create a Google Cloud Desktop OAuth client and run npm run calendar-auth locally.
CALENDAR_SYNC=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---------- Safety ----------
MAX_REPLIES_PER_HOUR=20

# ---------- Storage ----------
DATABASE_PATH=./data/maya.db
AUTH_DIR=./auth_info

# ---------- Logs ----------
# debug shows message text — only use it on your own machine
LOG_LEVEL=info
