# ---------- Bot ----------
# Her name. Use it at the start or mention @maya anywhere in either mode.
BOT_NAME=Maya

# self     = runs on your own WhatsApp number, you talk in "Message Yourself"
# separate = runs on a second number; the owner still uses the name trigger
BOT_MODE=self

# Only for BOT_MODE=separate: YOUR main number, e.g. 923001234567@s.whatsapp.net
OWNER_JID=

# Comma-separated group IDs to read. Get them with: npm run list-groups
GROUP_ALLOWLIST=

# Your timezone (IANA name), used for reminders and dates
TIMEZONE=Asia/Karachi

# ---------- Schedule (cron format, in TIMEZONE) ----------
MORNING_DIGEST_CRON=0 8 * * *
EVENING_DIGEST_CRON=0 20 * * *
WEEKLY_PLAN_CRON=0 20 * * 5
EXTRACT_INTERVAL_MIN=10

# ---------- AI ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
EXTRACT_BATCH_SIZE=50
ASK_CONTEXT_MESSAGES=100

# ---------- Safety ----------
MAX_REPLIES_PER_HOUR=20

# ---------- Storage ----------
DATABASE_PATH=./data/maya.db
AUTH_DIR=./auth_info

# ---------- Logs ----------
# debug shows message text — only use it on your own machine
LOG_LEVEL=info
